cmake_minimum_required(VERSION 3.24)
if(NOT APP OR NOT ARCH OR NOT MIN_MACOS)
    message(FATAL_ERROR "APP, ARCH and MIN_MACOS are required")
endif()
include(BundleUtilities)
get_bundle_all_executables("${APP}" executables)
file(GLOB_RECURSE libraries "${APP}/*.dylib")
foreach(binary IN LISTS executables libraries)
    execute_process(COMMAND xcrun vtool -arch "${ARCH}" -show-build "${binary}"
        RESULT_VARIABLE result OUTPUT_VARIABLE commands ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ${binary}: ${error}")
    endif()
    if(commands MATCHES "minos[ \t]+([0-9.]+)")
        set(minimum "${CMAKE_MATCH_1}")
    elseif(commands MATCHES "cmd LC_VERSION_MIN_MACOSX" AND commands MATCHES "version[ \t]+([0-9.]+)")
        set(minimum "${CMAKE_MATCH_1}")
    else()
        message(FATAL_ERROR "Missing macOS deployment target in ${binary}")
    endif()
    if(minimum VERSION_GREATER MIN_MACOS)
        message(FATAL_ERROR "${binary} requires macOS ${minimum}, above target ${MIN_MACOS}")
    endif()
    message(STATUS "Deployment audit: ${ARCH} macOS ${minimum} <= ${MIN_MACOS}: ${binary}")
endforeach()
